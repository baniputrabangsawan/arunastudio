generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("editor")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Lead {
  id           String        @id @default(cuid())
  name         String
  business     String?
  email        String?
  whatsapp     String
  status       LeadStatus    @default(NEW)
  source       String?
  notes        String?
  projectBrief ProjectBrief?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ProjectBrief {
  id           String   @id @default(cuid())
  submissionId String   @unique
  leadId       String   @unique
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  industry     String
  description  String
  websiteType  String
  goal         String
  features     String[]
  style        String?
  color        String?
  references   String[]
  budget       String
  timeline     String
  notes        String?
  createdAt    DateTime @default(now())
}

model Portfolio {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  category    String
  type        String           @default("Website")
  description String
  problem     String
  solution    String
  focus       String[]         @default([])
  isDemo      Boolean          @default(false)
  published   Boolean          @default(false)
  order       Int              @default(0)
  media       PortfolioMedia[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model PortfolioMedia {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  url         String
  alt         String
  type        String
  order       Int       @default(0)
}

model Service {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  group       String
  description String
  items       String[] @default([])
  published   Boolean @default(true)
  order       Int     @default(0)
}

model PricingPlan {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  priceMin    Int
  priceMax    Int?
  description String
  featured    Boolean          @default(false)
  published   Boolean          @default(true)
  order       Int              @default(0)
  features    PricingFeature[]
}

model PricingFeature {
  id       String      @id @default(cuid())
  planId   String
  plan     PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  label    String
  included Boolean     @default(true)
  order    Int         @default(0)
}

model FAQ {
  id        String  @id @default(cuid())
  question  String
  answer    String
  category  String?
  published Boolean @default(true)
  order     Int     @default(0)
}

model BlogCategory {
  id    String     @id @default(cuid())
  slug  String     @unique
  name  String
  posts BlogPost[]
}

model BlogPost {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  excerpt     String
  content     String
  coverUrl    String?
  order       Int          @default(0)
  publishedAt DateTime?
  categoryId  String
  category    BlogCategory @relation(fields: [categoryId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Availability {
  id             String   @id @default(cuid())
  status         String
  slots          Int      @default(0)
  estimatedStart DateTime?
  updatedAt      DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
